# --- Database (Supabase Postgres) ---
# Use the async driver. Get the connection string from Supabase > Project Settings > Database.
# Prefer the direct connection or the "Session" pooler. Add sslmode via connect args if needed.
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Seed admin (created by Alembic data migration) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- CORS (comma-separated origins allowed to call the API) ---
CORS_ORIGINS=http://localhost:3000

# --- App ---
APP_ENV=development

# --- Google Sheets sync (see README "Google Sheets sync") ---
# Off by default; approvals only queue sheet writes when this is true.
SHEET_SYNC_ENABLED=false
# Service-account key: paste the JSON file contents (one line) or base64 of it.
GOOGLE_SERVICE_ACCOUNT_JSON=
# From the sheet URL: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=
# Tab name at the bottom of the sheet, e.g. Sheet1
GOOGLE_SHEET_TAB=
# Failed writes are retried by the daily cron until this many attempts.
SHEET_SYNC_MAX_ATTEMPTS=5
# Same value as the frontend's CRON_SECRET.
CRON_SECRET=change-me-to-a-long-random-string

# --- AI that reads the sheet layout ---
# gemini (Google AI Studio key) or grok (console.x.ai key)
AI_PROVIDER=gemini
AI_API_KEY=
# A small, fast model is plenty; check the provider's docs for current IDs
# (e.g. a Gemini "Flash" model, or a Grok "mini"/"fast" model).
AI_MODEL=
