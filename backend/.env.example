# --- Database (Supabase Postgres) ---
# Use the async driver. Get the connection string from Supabase > Project Settings > Database.
# Prefer the direct connection or the "Session" pooler. Add sslmode via connect args if needed.
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Seed admin (created by Alembic data migration) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- CORS (comma-separated origins allowed to call the API) ---
CORS_ORIGINS=http://localhost:3000

# --- App ---
APP_ENV=development
